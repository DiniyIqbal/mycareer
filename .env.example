# Template only — committed to git. Copy to .env.local and put real values THERE.

# Supabase project (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_JWKS_URL=https://your-project.supabase.co/auth/v1/.well-known/jwks.json

# Public base URL, used for canonical links, JSON-LD and email links
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Email: "gmail" for testing, "resend" for production
EMAIL_PROVIDER=gmail
# Gmail SMTP — needs 2-Step Verification + an App Password (https://myaccount.google.com/apppasswords)
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# With Gmail, the From address must be GMAIL_USER (or a verified alias)
EMAIL_FROM="MyCareer <you@gmail.com>"

# Resend (https://resend.com)
RESEND_API_KEY=

# Email queue worker (/api/cron/messages). Any long random string, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Your scheduler must send: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=
